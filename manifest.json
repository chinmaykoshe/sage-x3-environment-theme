{
  "manifest_version": 3,
  "name": "Sage X3 Environment Theme",
  "version": "2.0.0",
  "description": "Color-codes the Sage X3 header by environment and lets you configure URL/header matches.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://*.hightideventures.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hightideventures.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Sage X3 Environment Theme",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}